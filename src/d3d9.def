; Exports must match the real d3d9.dll surface undecorated. Without this file
; MSVC would emit x86 stdcall-decorated names (_Direct3DCreate9@4) and the game
; would fail to resolve them.
EXPORTS
    Direct3DCreate9
    Direct3DCreate9Ex
    D3DPERF_BeginEvent
    D3DPERF_EndEvent
    D3DPERF_GetStatus
    D3DPERF_QueryRepeatFrame
    D3DPERF_SetMarker
    D3DPERF_SetOptions
    D3DPERF_SetRegion
